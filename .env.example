# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Telegram BotFather token and webhook secret
TELEGRAM_BOT_TOKEN=123456:YOUR_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
# Numeric Telegram user ID allowed to save links (comma-separated for multiple owners)
TELEGRAM_ALLOWED_USER_IDS=123456789

# Set to the deployed Vercel URL, without trailing slash
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Email allowed to sign in to the private dashboard
NEXT_PUBLIC_OWNER_EMAIL=you@example.com
# Secret used once to register/update the Telegram webhook
WEBHOOK_SETUP_KEY=replace-with-another-long-random-secret
